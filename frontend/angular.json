{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "api": {
      "projectType": "library",
      "root": "projects/api",
      "sourceRoot": "projects/api/src",
      "prefix": "qbc",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/api/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/api/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/api/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "components": {
      "projectType": "library",
      "root": "projects/components",
      "sourceRoot": "projects/components/src",
      "prefix": "qbc",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/components/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/components/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/components/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/components/tsconfig.spec.json",
            "runner": "vitest",
            "runnerConfig": "projects/components/vitest.config.ts",
            "watch": false
          }
        }
      }
    },
    "qbc-workboard": {
      "projectType": "application",
      "root": "projects/qbc-workboard",
      "sourceRoot": "projects/qbc-workboard/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/qbc-workboard/src/main.ts",
            "tsConfig": "projects/qbc-workboard/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/qbc-workboard/public"
              }
            ],
            "styles": [
              "projects/components/src/styles.scss",
              "projects/qbc-workboard/src/styles.scss",
              {
                "input": "node_modules/monaco-editor/min/vs/editor/editor.main.css",
                "bundleName": "monaco-editor",
                "inject": false
              }
            ],
            "outputPath": "dist/qbc-workboard",
            "loader": {
              ".ttf": "file"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "20kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "qbc-workboard:build:production"
            },
            "development": {
              "buildTarget": "qbc-workboard:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
