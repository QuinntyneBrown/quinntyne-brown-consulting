{
  "name": "qbc-workboard-workspace",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node scripts/build-app.mjs serve --proxy-config proxy.conf.json",
    "build": "npm run build:api && npm run build:components && npm run build:app",
    "build:api": "ng build api",
    "build:components": "ng build components",
    "build:app": "node scripts/build-app.mjs build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:components": "ng test components --watch=false",
    "validate:components": "node scripts/validate-component-boundary.mjs",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "test:e2e": "playwright test",
    "test:e2e:version": "playwright test --config playwright.version.config.ts"
  },
  "dependencies": {
    "@angular/common": "21.2.22",
    "@angular/compiler": "21.2.22",
    "@angular/core": "21.2.22",
    "@angular/forms": "21.2.22",
    "@angular/platform-browser": "21.2.22",
    "@angular/router": "21.2.22",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.23",
    "@angular/cli": "21.2.23",
    "@angular/compiler-cli": "21.2.22",
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.0",
    "jsdom": "27.2.0",
    "ng-packagr": "21.2.7",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "playwright-core": "1.55.1"
  }
}
