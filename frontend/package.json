{
  "name": "qbc-workboard-workspace",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node scripts/build-app.mjs serve --proxy-config proxy.conf.json",
    "serve:dist": "node scripts/serve-dist.mjs",
    "build": "npm run build:api && npm run build:components && npm run build:app",
    "build:api": "ng build api",
    "build:components": "ng build components",
    "build:app": "node scripts/build-app.mjs build",
    "lint": "ng lint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:components": "ng test components --watch=false",
    "validate:components": "node scripts/validate-component-boundary.mjs",
    "storybook": "ng run components:storybook",
    "build-storybook": "ng run components:build-storybook",
    "test:storybook": "playwright test --config=playwright.storybook.config.ts",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "test:e2e": "playwright test",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@angular/common": "21.2.22",
    "@angular/compiler": "21.2.22",
    "@angular/core": "21.2.22",
    "@angular/forms": "21.2.22",
    "@angular/platform-browser": "21.2.22",
    "@angular/router": "21.2.22",
    "monaco-editor": "0.56.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.23",
    "@angular/animations": "21.2.22",
    "@angular/build": "21.2.23",
    "@angular/cli": "21.2.23",
    "@angular/compiler-cli": "21.2.22",
    "@angular/platform-browser-dynamic": "21.2.22",
    "@axe-core/playwright": "4.11.1",
    "@compodoc/compodoc": "2.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.55.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/angular": "10.6.1",
    "@types/node": "22.18.0",
    "angular-eslint": "21.4.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "http-server": "14.1.1",
    "husky": "9.1.7",
    "jsdom": "27.2.0",
    "lint-staged": "16.4.0",
    "ng-packagr": "21.2.7",
    "prettier": "3.9.6",
    "storybook": "10.6.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "playwright-core": "1.55.1"
  }
}
