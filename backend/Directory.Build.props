<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <!-- The product version the workspace reports as its deployed build. Bump it here. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Keep version and revision as separate assembly metadata values. InformationalVersion
       is unsuitable as a data contract because semantic versions may contain '+' metadata. -->
  <Target Name="AddQbcBuildMetadata" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyMetadata Include="QbcBuildVersion" Value="$(Version)" />
      <AssemblyMetadata Include="QbcSourceRevision" Value="$(SourceRevisionId)" Condition="'$(SourceRevisionId)' != ''" />
    </ItemGroup>
  </Target>
</Project>

