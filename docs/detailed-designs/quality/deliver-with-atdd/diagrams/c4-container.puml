@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Deliver vertical slices with ATDD

Person(implementer, "Product implementer", "Runs the red-green-refactor cycle")
System_Boundary(workboard, "QBC Workboard test environment") {
  Container(playwright, "Browser acceptance suite", "Playwright", "Runs specifications through page objects")
  Container(spa, "Web application", "Angular", "Renders product behavior")
  Container(mockApi, "Mock API contract", "Playwright route fixture", "Provides fresh stateful HTTP behavior per browser test")
  Container(apiTests, "Backend integration suite", ".NET test host", "Exercises the real ASP.NET Core pipeline")
  Container(api, "Workboard API", "ASP.NET Core", "Runs controllers, MediatR, and persistence")
  ContainerDb(db, "Isolated test database", "SQL Server Express", "Stores scenario-owned data")
}
System_Ext(changeRecord, "Change record", "Stores acceptance evidence")

Rel(implementer, playwright, "Runs user-visible scenarios in")
Rel(implementer, apiTests, "Runs backend scenarios in")
Rel(playwright, spa, "Drives through page objects", "Browser")
Rel(spa, mockApi, "Calls during browser tests", "JSON/HTTP")
Rel(playwright, mockApi, "Installs and verifies")
Rel(apiTests, api, "Hosts and calls in process", "HTTP")
Rel(api, db, "Reads and writes", "EF Core")
Rel(playwright, changeRecord, "Supplies red and green results to")
Rel(apiTests, changeRecord, "Supplies red and green results to")
@enduml
