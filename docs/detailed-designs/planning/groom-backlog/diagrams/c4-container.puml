@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Groom the backlog

Person(consultant, "QBC consultant", "Searches, filters, and grooms stories")
System_Boundary(workboard, "QBC Workboard") {
  Container(spa, "Web application", "Angular", "Filters backlog data and presents grooming actions")
  Container(api, "Workboard API", "ASP.NET Core", "Queries backlog context and enforces readiness")
  ContainerDb(db, "Workspace database", "SQL Server Express", "Stores story planning state")
}

Rel(consultant, spa, "Uses", "HTTPS")
Rel(spa, api, "Queries backlog and submits readiness", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
