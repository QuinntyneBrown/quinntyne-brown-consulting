@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Groom the backlog

Person(consultant, "QBC consultant", "Prepares stories for planning")
Container_Boundary(spa, "Angular web application") {
  Component(page, "BacklogPageComponent", "Angular component", "Displays story planning context")
  Component(filter, "BacklogFilterComponent", "Angular component", "Captures search and filter criteria")
  Component(store, "BacklogStore", "Angular Signal store", "Computes visible stories")
  Component(service, "IBacklogService", "Injection-token contract", "Loads backlog and submits readiness")
}
Container_Boundary(api, "Workboard API") {
  Component(controller, "StoriesController", "ASP.NET Core controller", "Exposes backlog and grooming actions")
  Component(handler, "GroomStoryCommandHandler", "MediatR handler", "Applies readiness validation")
  Component(policy, "StoryReadinessPolicy", "Domain policy", "Checks required grooming fields")
  ComponentDb(db, "Workspace database", "SQLite", "Stores stories and planning state")
}

Rel(consultant, filter, "Searches and filters with")
Rel(filter, store, "Updates criteria in")
Rel(page, store, "Reads computed results from")
Rel(page, service, "Requests grooming through")
Rel(service, controller, "Calls", "JSON/HTTPS")
Rel(controller, handler, "Sends command")
Rel(handler, policy, "Evaluates story with")
Rel(handler, db, "Reads and writes", "EF Core")
@enduml
