@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Plan two-week sprints

Person(consultant, "QBC consultant", "Creates and starts sprint plans")
System_Boundary(workboard, "QBC Workboard") {
  Container(spa, "Web application", "Angular", "Renders sprint manager and assignment controls")
  Container(api, "Workboard API", "ASP.NET Core", "Enforces sprint and story planning rules")
  ContainerDb(db, "Workspace database", "SQLite", "Stores sprints and story assignments")
}

Rel(consultant, spa, "Uses", "HTTPS")
Rel(spa, api, "Sends sprint and assignment operations", "JSON/HTTPS")
Rel(api, db, "Reads and writes transactionally", "EF Core")
@enduml
