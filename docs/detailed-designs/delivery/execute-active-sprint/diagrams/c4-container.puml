@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Execute the active sprint

Person(consultant, "QBC consultant", "Tracks the current commitment")
System_Boundary(workboard, "QBC Workboard") {
  Container(spa, "Web application", "Angular", "Renders sprint summary, columns, and story cards")
  Container(api, "Workboard API", "ASP.NET Core", "Handles board queries, movement, and completion")
  ContainerDb(db, "Workspace database", "SQLite", "Stores sprint and story states")
}

Rel(consultant, spa, "Uses", "HTTPS")
Rel(spa, api, "Queries board and submits transitions", "JSON/HTTPS")
Rel(api, db, "Reads and writes transactionally", "EF Core")
@enduml
