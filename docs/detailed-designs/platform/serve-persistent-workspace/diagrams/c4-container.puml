@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Serve the persistent workspace

Person(consultant, "QBC consultant", "Uses the web product")
System_Boundary(workboard, "QBC Workboard") {
  Container(spa, "Web application", "Angular", "Consumes typed API resources")
  Container(api, "Workboard API", "ASP.NET Core", "Hosts controllers and the composition root")
  ContainerDb(db, "Workspace database", "SQLite", "Stores all workspace records durably")
}

Rel(consultant, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and commits", "EF Core")
@enduml
