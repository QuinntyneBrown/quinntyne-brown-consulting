@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Render the Angular workspace

Person(consultant, "QBC consultant", "Interacts with rendered features")
Container_Boundary(spa, "Angular multi-project workspace") {
  Component(page, "Feature pages", "qbc-workboard", "Read Signals and delegate actions")
  Component(appcontract, "Feature service contracts", "qbc-workboard", "Define application state and commands")
  Component(store, "Feature services", "qbc-workboard", "Own writable and computed Signals")
  Component(apicontract, "Service contracts and DTOs", "@qbc/api", "Define typed backend operations")
  Component(client, "Backend services", "@qbc/api", "Terminate HttpClient Observables as Promises")
  Component(ui, "Reusable UI components", "@qbc/components", "Render presentation without workflow state")
  Component(providers, "Provider factories", "Angular dependency injection", "Alias tokens with useExisting")
}
Container(api, "Workboard API", "ASP.NET Core", "Returns typed data and Problem Details")

Rel(consultant, page, "Uses")
Rel(page, appcontract, "Injects token and invokes")
Rel(page, ui, "Composes")
Rel(appcontract, store, "Aliased to")
Rel(store, apicontract, "Injects token and invokes")
Rel(apicontract, client, "Aliased to")
Rel(client, api, "Calls", "JSON/HTTPS")
Rel(store, page, "Exposes read-only Signals")
Rel(providers, appcontract, "Registers")
Rel(providers, apicontract, "Registers")
@enduml
