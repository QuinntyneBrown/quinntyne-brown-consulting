@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Render the Angular workspace

Person(consultant, "QBC consultant", "Interacts with rendered features")
Container_Boundary(spa, "Angular web application") {
  Component(component, "FeatureComponent", "Angular component", "Reads Signals and delegates actions")
  Component(contract, "IResourceService and token", "Angular contract", "Defines state and commands")
  Component(service, "ResourceService", "Root Angular service", "Calls HTTP and owns writable Signals")
  Component(store, "Feature Signal state", "Angular Signals", "Exposes read-only and computed state")
  Component(error, "ApiErrorPresenter", "Angular service", "Maps Problem Details to feedback")
  Component(providers, "provideWorkboardServices", "Angular providers", "Aliases tokens with useExisting")
}
Container(api, "Workboard API", "ASP.NET Core", "Returns typed data and Problem Details")

Rel(consultant, component, "Uses")
Rel(component, contract, "Injects token and invokes")
Rel(contract, service, "Aliased to")
Rel(providers, contract, "Provides")
Rel(providers, service, "Aliases existing singleton")
Rel(service, api, "Calls", "JSON/HTTPS")
Rel(service, store, "Updates")
Rel(component, store, "Reads")
Rel(service, error, "Reports API failures to")
@enduml
