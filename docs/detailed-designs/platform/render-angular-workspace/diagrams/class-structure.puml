@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Render the Angular workspace

interface IBacklogService {
  +Signal<readonly Story[]> stories
  +Signal<readonly Story[]> visibleStories
  +Signal<LoadingState> loadingState
  +load(): Promise<void>
  +groom(id: string): Promise<boolean>
}

class BacklogService {
  -IStoryService backendService
  -WritableSignal<readonly Story[]> storiesValue
  -WritableSignal<LoadingState> loadingValue
  +load(): Promise<void>
  +groom(id: string): Promise<boolean>
}

interface IStoryService {
  +getBacklog(): Promise<readonly Story[]>
  +groom(id: string): Promise<Story>
}

class StoryService {
  -HttpClient http
  +getBacklog(): Promise<readonly Story[]>
  +groom(id: string): Promise<Story>
}

class BacklogPageComponent {
  +IBacklogService service
}

class Story {
  +string id
  +string key
  +string title
  +boolean isReady
}

enum LoadingState {
  idle
  loading
  loaded
  failed
}

class QbcServicesProviders {
  +provideQbcServices(): EnvironmentProviders
}

class QbcWorkboardProviders {
  +provideQbcWorkboard(): EnvironmentProviders
}

IBacklogService <|.. BacklogService
IStoryService <|.. StoryService
BacklogPageComponent ..> IBacklogService : injects token
BacklogService ..> IStoryService : injects token
BacklogService --> Story : exposes
BacklogService --> LoadingState : owns
QbcWorkboardProviders ..> IBacklogService : aliases singleton
QbcServicesProviders ..> IStoryService : aliases singleton
@enduml
