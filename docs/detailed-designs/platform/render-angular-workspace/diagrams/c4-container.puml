@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Render the Angular workspace

Person(consultant, "QBC consultant", "Uses the web application")
System_Boundary(workboard, "QBC Workboard") {
  Container(spa, "qbc-workboard application", "Angular", "Composes libraries and renders Signal state")
  Container(api, "Workboard API", "ASP.NET Core", "Provides authoritative typed resources")
  ContainerDb(db, "Workspace database", "SQL Server Express", "Stores product data")
}

Rel(consultant, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls through @qbc/api", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
