@startuml
title UML sequence behaviour — Load and groom backlog state
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "QBC consultant" as actor
box "Frontend — qbc-workboard application" #E0F2FE
  participant "BacklogPageComponent" as page
  participant "IBacklogService token" as appcontract
  participant "BacklogService" as store
end box
box "Frontend — @qbc/api library" #E0F2FE
  participant "IStoryService token" as apicontract
  participant "StoryService" as client
end box
box "Backend — QBC Workboard API" #D1FADF
  participant "StoriesController" as controller
end box
box "Backend — QBC Workboard Application and Domain" #ECFDF3
  participant "Story request handler" as handler
end box
box "Backend — QBC Workboard Infrastructure" #FFF4E5
  database "Workspace database" as db
end box

actor -> page : Activate backlog route
page -> appcontract : load()
appcontract -> store : Resolve L2-033 useExisting alias
store -> store : Set Loading Signal
store -> apicontract : getBacklog()
apicontract -> client : Resolve service useExisting alias
client -> controller : GET /api/stories/backlog
controller -> handler : Send GetBacklogQuery
handler -> db : Read stories
db --> handler : Persisted stories
handler --> controller : StoryDto list
controller --> client : 200 JSON
client --> store : Promise<readonly Story[]>
store -> store : Apply L2-032 Signals
store --> page : Read-only and computed Signals
page --> actor : Present L2-034 backlog

actor -> page : Mark complete story Ready
page -> appcontract : groom(storyId)
appcontract -> store : Invoke BacklogService
store -> apicontract : groom(storyId)
apicontract -> client : Invoke StoryService
client -> controller : POST /api/stories/{id}/groom
controller -> handler : Send GroomStoryCommand
handler -> db : Validate and commit
db --> handler : Authoritative story
handler --> controller : StoryDto
alt request succeeds
  controller --> client : 200 JSON
  client --> store : Promise<Story>
  store -> apicontract : getBacklog()
  apicontract -> client : Invoke StoryService
  client -> controller : GET /api/stories/backlog
  controller --> client : 200 JSON
  client --> store : Authoritative stories
  store -> store : Update Signals
  store --> page : Render Ready state
  page --> actor : Present success
else request fails
  controller --> client : RFC 9457 Problem Details
  client --> store : Reject Promise
  store -> store : Set Failed state and feedback
  store --> page : Render actionable failure
  page --> actor : Preserve form state and present error
end
@enduml
