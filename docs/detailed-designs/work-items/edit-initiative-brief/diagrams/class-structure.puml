@startuml
title UML class structure — Write an initiative
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #FFFFFF
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

package "qbc-workboard — initiative brief" {
  class HierarchyPageComponent {
    +newInitiative()
    +editInitiative(initiative)
    +summarise(description) : string
  }

  class InitiativeBriefPageComponent {
    +Signal<string|undefined> initiativeId
    +Signal<string> draftName
    +Signal<string> draftBrief
    +Signal<InitiativeDraft> baseline
    +Signal<boolean> isNew
    +Signal<boolean> dirty
    +Signal<string> rendered
    +runCommand(command)
    +insertTemplate()
    +showView(view)
    +save() : Promise<boolean>
    +discard()
    +confirmLeaving() : Promise<boolean>
  }

  interface IInitiativeBriefService {
    +Signal<Initiative> initiative
    +load(id) : Promise<void>
    +create(name, description) : Promise<Initiative|null>
    +save(id, name, description) : Promise<Initiative|null>
  }

  class InitiativeBriefService

  class BriefEditorComponent {
    +Signal<BriefEditorState> state
    +output ready : BriefEditorHandle
  }

  interface BriefEditorHandle {
    +getState() : EditorSelection
    +apply(next)
    +getValue() : string
    +setValue(text)
    +focus()
    +onChange(handler)
  }

  class createMonacoEditor <<factory>>

  class MARKDOWN_COMMANDS <<pure>> {
    +bold(state) : EditorSelection
    +heading(state) : EditorSelection
    +task(state) : EditorSelection
    +table(state) : EditorSelection
  }

  class renderMarkdown <<pure>>
  class summariseBrief <<pure>>
  class BRIEF_TEMPLATE <<constant>>

  class EditorSelection <<record>> {
    +string text
    +number start
    +number end
  }

  class InitiativeDraft <<record>> {
    +string name
    +string description
  }
}

package "@qbc/api" {
  interface IHierarchyService {
    +getInitiative(id) : Promise<Initiative>
    +createInitiative(name, description) : Promise<Initiative>
    +updateInitiative(id, name, description) : Promise<Initiative>
  }
  class Initiative <<record>> {
    +string id
    +string name
    +string description
  }
}

package "Qbc.Workboard.Application" {
  class SaveInitiativeCommand <<record>> {
    -int MaxDescriptionLength
    +Validate() : IReadOnlyDictionary
  }
}

InitiativeBriefPageComponent --> IInitiativeBriefService : loads and saves through
InitiativeBriefService ..|> IInitiativeBriefService
InitiativeBriefService --> IHierarchyService : reads and writes the initiative
IHierarchyService --> Initiative : returns
InitiativeBriefPageComponent --> BriefEditorComponent : hosts
BriefEditorComponent --> BriefEditorHandle : reports one
createMonacoEditor ..> BriefEditorHandle : creates
InitiativeBriefPageComponent ..> MARKDOWN_COMMANDS : applies
InitiativeBriefPageComponent ..> renderMarkdown : previews with
InitiativeBriefPageComponent ..> BRIEF_TEMPLATE : starts a new brief from
InitiativeBriefPageComponent --> InitiativeDraft : holds as its baseline
HierarchyPageComponent ..> summariseBrief : summarises a card with
MARKDOWN_COMMANDS --> EditorSelection : rewrites
BriefEditorHandle --> EditorSelection : reads and applies
IHierarchyService ..> SaveInitiativeCommand : is validated by
@enduml
