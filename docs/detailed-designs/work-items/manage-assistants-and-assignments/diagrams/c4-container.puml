@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Manage assistants and assignments

Person(consultant, "QBC consultant", "Assigns delivery work")
System_Boundary(workboard, "QBC Workboard") {
  Container(spa, "Web application", "Angular", "Renders directory and assignment controls")
  Container(api, "Workboard API", "ASP.NET Core", "Handles profiles, workload, and deletion guards")
  ContainerDb(db, "Workspace database", "SQL Server Express", "Stores assistants and assignment references")
}

Rel(consultant, spa, "Uses", "HTTPS")
Rel(spa, api, "Sends assistant and assignment operations", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
