@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Log hours across stories

Person(consultant, "QBC consultant", "Records one total across several stories")
System_Boundary(workboard, "QBC Workboard") {
  Container(spa, "Web application", "Angular", "Previews the division and posts the group")
  Container(api, "Workboard API", "ASP.NET Core", "Validates the group, divides the total, and records one entry per story")
  ContainerDb(db, "Workspace database", "SQL Server Express", "Stores the resulting time entries in one commit")
}

Rel(consultant, spa, "Uses", "HTTPS")
Rel(spa, api, "Posts a group and reads the assistant's hours", "JSON/HTTPS")
Rel(api, db, "Writes the entries together", "EF Core")
@enduml
